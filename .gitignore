# Editor settings
.idea/

# Build output (e.g. go build -o bin/ .)
/bin/
*.exe
*.test

# Coverage profiles (e.g. go test -coverprofile=cover.out ./...)
*.out

# Text files templ writes in watch mode (mise run dev)
*_templ.txt

# Environment files, which may hold a Jira API token; the app no longer reads them
/.env
