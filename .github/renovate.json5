{
  extends: [
    'config:recommended',
    'helpers:pinGitHubActionDigests',
  ],
  schedule: [
    'before 5am on the first day of the month',
  ],
  minimumReleaseAge: '3 days',
  minimumReleaseAgeBehaviour: 'timestamp-required',
  internalChecksFilter: 'strict',
  semanticCommits: 'enabled',
  commitMessageLowerCase: 'never',
  configMigration: true,
  dependencyDashboard: {
    enabled: true,
  },
  osvVulnerabilityAlerts: true,
  vulnerabilityAlerts: {
    schedule: [
      'at any time',
    ],
    minimumReleaseAge: null,
  },
  postUpdateOptions: [
    'gomodTidy',
  ],
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        'internal/web/views/*.templ',
        'internal/web/views/*_templ.go',
      ],
      matchStrings: [
        'alpine-(?<currentValue>\\d+\\.\\d+\\.\\d+)\\.min\\.js',
      ],
      depNameTemplate: 'alpinejs',
      datasourceTemplate: 'npm',
    },
  ],
  packageRules: [
    {
      matchDepNames: [
        'alpinejs',
      ],
      prBodyNotes: [
        'Renovate only bumps the reference. Replace the vendored file before merging:\n\n```sh\ncurl -fsSL -o internal/web/static/vendor/alpine-{{{newVersion}}}.min.js https://cdn.jsdelivr.net/npm/alpinejs@{{{newVersion}}}/dist/cdn.min.js\nrm internal/web/static/vendor/alpine-{{{currentVersion}}}.min.js\n```',
      ],
    },
    {
      groupName: 'Go',
      matchDepNames: [
        'go',
      ],
    },
    {
      groupName: 'committed',
      matchPackageNames: [
        'crate-ci/committed',
        'committed',
      ],
    },
    {
      matchManagers: [
        'github-actions',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
        'digest',
      ],
      groupName: 'compatible (actions)',
    },
    {
      matchManagers: [
        'mise',
      ],
      matchDepNames: [
        '!go',
        '!committed',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
      groupName: 'compatible (mise)',
    },
  ],
}
