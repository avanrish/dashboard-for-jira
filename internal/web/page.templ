package web

import "github.com/avanrish/dashboard-for-jira/internal/board"

templ page(boardData board.Board) {
	<!DOCTYPE html>
	<html lang="en" class="h-full">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ boardData.Name } · Dashboard for Jira</title>
			<link rel="stylesheet" href="/static/app.css"/>
		</head>
		<body class="flex h-full flex-col bg-slate-100 text-slate-900 antialiased dark:bg-slate-950 dark:text-slate-100">
			<header class="flex items-center gap-4 border-b border-slate-200 bg-white px-6 py-3 dark:border-slate-800 dark:bg-slate-900">
				<h1 class="text-lg font-semibold">{ boardData.Name }</h1>
			</header>
			<main class="min-h-0 flex-1 overflow-x-auto p-6">
				@boardView(boardData)
			</main>
		</body>
	</html>
}
