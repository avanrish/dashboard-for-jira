package views

import (
	"fmt"
	"strconv"

	"github.com/avanrish/dashboard-for-jira/internal/board"
)

templ BoardPage(boardData board.Board, collapsed map[string]bool) {
	@layout(fmt.Sprintf("%s · Dashboard for Jira", boardData.Name)) {
		<header class="flex items-center gap-4 border-b border-line bg-surface px-6 py-3">
			<h1 class="text-lg font-semibold">{ boardData.Name }</h1>
		</header>
		<main class="min-h-0 flex-1 overflow-auto">
			@boardView(boardData, collapsed)
		</main>
		<script>
			document.addEventListener("alpine:init", () => {
				Alpine.data("epics", () => ({
					save(event) {
						const epic = event.target.dataset.epic;
						// LINT.IfChange(collapsed_epics_cookie)
						const cookie = document.cookie.split("; ").find((c) => c.startsWith("collapsed_epics="));
						const collapsed = new Set(cookie?.slice("collapsed_epics=".length).split(",").filter(Boolean));
						if (event.target.open) {
							collapsed.delete(epic);
						} else {
							collapsed.add(epic);
						}
						document.cookie = `collapsed_epics=${[...collapsed].join(",")}; Path=/; Max-Age=31536000; SameSite=Lax`;
						// LINT.ThenChange(//internal/web/server.go:collapsed_epics_cookie)
					},
				}));
			});
		</script>
	}
}

templ boardView(boardData board.Board, collapsed map[string]bool) {
	<div class="w-max min-w-full px-6 pb-6" x-data="epics" @toggle.capture="save">
		<div class="sticky top-0 z-10 flex gap-2 bg-page pt-4 pb-1">
			for i, name := range boardData.Columns {
				<h2 class="flex w-50 shrink-0 items-center justify-between rounded-lg bg-column px-2.5 py-1.5 text-xs font-semibold tracking-wide text-fg-muted uppercase">
					{ name }
					<span class="rounded-full bg-chip px-2 py-0.5 text-fg">
						{ strconv.Itoa(boardData.ColumnIssueCount(i)) }
					</span>
				</h2>
			}
		</div>
		if len(boardData.Epics) == 0 {
			<p class="mt-4 text-sm text-fg-muted">No issues on this board.</p>
		}
		for _, epic := range boardData.Epics {
			@epicView(epic, collapsed[epicID(epic)])
		}
	</div>
}

// epicView uses <details> so epics collapse and expand without JavaScript.
templ epicView(epic board.Epic, collapsed bool) {
	<details open?={ !collapsed } data-epic={ epicID(epic) } class="group mt-3">
		<summary class="sticky left-6 flex w-fit cursor-pointer list-none items-center gap-2 py-1 text-sm [&::-webkit-details-marker]:hidden">
			<svg class="size-4 shrink-0 text-fg-muted transition-transform group-open:rotate-90" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M6 3.5 10.5 8 6 12.5"></path>
			</svg>
			if epic.Key == "" {
				<span class="font-medium text-fg-muted">Issues without epic</span>
			} else {
				<span class={ "size-3.5 shrink-0 rounded-[3px]", epicClass(epic.Color) }></span>
				<a href={ templ.URL(epic.URL) } target="_blank" rel="noopener noreferrer" class="font-mono text-xs text-fg-muted hover:underline">{ epic.Key }</a>
				<span class="font-medium">{ epic.Summary }</span>
			}
			<span class="text-fg-muted">{ issueCount(epic.IssueCount()) }</span>
		</summary>
		<div class="mt-1 flex gap-2">
			for _, issues := range epic.Cells {
				<ul class="flex min-h-10 w-50 shrink-0 flex-col gap-1.5 rounded-lg bg-column p-1.5">
					for _, issue := range issues {
						<li>
							@card(issue)
						</li>
					}
				</ul>
			}
		</div>
	</details>
}

func epicID(epic board.Epic) string {
	if epic.Key == "" {
		return "no-epic"
	}
	return epic.Key
}

// epicClass fills an epic's square with its colour from Jira; epics without one use the epic role.
func epicClass(color string) string {
	switch color {
	// LINT.IfChange(epic_colors)
	case "dark-gray":
		return "bg-epic-dark-gray"
	case "dark-yellow":
		return "bg-epic-dark-yellow"
	case "yellow":
		return "bg-epic-yellow"
	case "dark-blue":
		return "bg-epic-dark-blue"
	case "dark-teal":
		return "bg-epic-dark-teal"
	case "green":
		return "bg-epic-green"
	case "purple":
		return "bg-epic-purple"
	case "dark-purple":
		return "bg-epic-dark-purple"
	case "orange":
		return "bg-epic-orange"
	case "blue":
		return "bg-epic-blue"
	case "teal":
		return "bg-epic-teal"
	case "gray":
		return "bg-epic-gray"
	case "dark-green":
		return "bg-epic-dark-green"
	case "dark-orange":
		return "bg-epic-dark-orange"
	// LINT.ThenChange(
	//     //internal/jira/epics.go:epic_colors,
	//     //internal/web/tailwind.css:epic_colors,
	// )
	default:
		return "bg-epic"
	}
}

func issueCount(count int) string {
	if count == 1 {
		return "1 issue"
	}
	return fmt.Sprintf("%d issues", count)
}
