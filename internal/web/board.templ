package web

import (
	"strconv"
	"strings"
	"unicode"
	"unicode/utf8"

	"github.com/avanrish/dashboard-for-jira/internal/board"
)

templ boardView(boardData board.Board) {
	<div id="board" class="flex h-full items-start gap-4">
		for _, col := range boardData.Columns {
			@column(col)
		}
	</div>
}

templ column(col board.Column) {
	<section class="flex max-h-full w-72 shrink-0 flex-col rounded-lg bg-column">
		<h2 class="flex items-center justify-between px-3 pt-3 pb-2 text-xs font-semibold tracking-wide text-fg-muted uppercase">
			{ col.Name }
			<span class="rounded-full bg-chip px-2 py-0.5 text-fg">
				{ strconv.Itoa(len(col.Issues)) }
			</span>
		</h2>
		if len(col.Issues) == 0 {
			<p class="px-3 pt-1 pb-4 text-sm text-fg-muted">No issues</p>
		} else {
			<ul class="flex flex-col gap-2 overflow-y-auto px-2 pb-2">
				for _, issue := range col.Issues {
					<li>
						@card(issue)
					</li>
				}
			</ul>
		}
	</section>
}

templ card(issue board.Issue) {
	<article class="rounded-md bg-card p-3 shadow-sm ring-1 ring-line">
		<p class="text-sm leading-snug">{ issue.Summary }</p>
		<div class="mt-3 flex items-center gap-2 text-xs text-fg-muted">
			<span class={ "rounded px-1.5 py-0.5 font-medium", typeClass(issue.Type) }>{ issue.Type }</span>
			<span class="font-mono">{ issue.Key }</span>
			if issue.Priority != "" {
				<span title="Priority">{ issue.Priority }</span>
			}
			@avatar(issue.Assignee)
		</div>
	</article>
}

templ avatar(name string) {
	if name == "" {
		<span title="Unassigned" class="ml-auto size-6 rounded-full border border-dashed border-fg-muted"></span>
	} else {
		<span title={ name } class="ml-auto flex size-6 items-center justify-center rounded-full bg-accent text-[10px] font-semibold text-on-accent">
			{ initials(name) }
		</span>
	}
}

// typeClass lives in this .templ file because Tailwind only scans .templ files for class names.
func typeClass(issueType string) string {
	switch issueType {
	case "Story":
		return "bg-story-soft text-story"
	case "Bug":
		return "bg-bug-soft text-bug"
	case "Task":
		return "bg-task-soft text-task"
	default:
		return "bg-chip text-fg"
	}
}

// initials takes the first and last words, so "Ada King Lovelace" gives "AL".
func initials(name string) string {
	words := strings.Fields(name)
	if len(words) == 0 {
		return ""
	}
	first, _ := utf8.DecodeRuneInString(words[0])
	if len(words) == 1 {
		return string(unicode.ToUpper(first))
	}
	last, _ := utf8.DecodeRuneInString(words[len(words)-1])
	return string([]rune{unicode.ToUpper(first), unicode.ToUpper(last)})
}
