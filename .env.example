# Copy this file to .env and fill it in. Variables set in the environment take precedence over .env.

# Your Jira Cloud site, without https://
JIRA_SITE=example.atlassian.net
# The email address of your Atlassian account
JIRA_EMAIL=you@example.com
# Create one at https://id.atlassian.com/manage-profile/security/api-tokens; it expires within a year
JIRA_API_TOKEN=
# The number in the board's address: .../boards/<id>
JIRA_BOARD_ID=1

# Optional. The port on 127.0.0.1 to serve the dashboard on; `mise run dev` expects the default, 8080.
# PORT=8080
